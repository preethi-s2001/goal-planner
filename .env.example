# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY)
# Required for account deletion (supabase.auth.admin.deleteUser) and cascade administrative tasks.
# NEVER prefix with NEXT_PUBLIC_ or expose to the browser!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic Claude API Configuration (Server-side routes only)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional model override (defaults to 'claude-sonnet-5-5')
ANTHROPIC_MODEL=claude-sonnet-5-5

# App URL (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
